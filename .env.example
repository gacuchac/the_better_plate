# THE BETTER PLATE — CONFIGURATION TEMPLATE (names and safe defaults only)
#
# Local use: you do not need to copy this. `pnpm dev` / `pnpm setup` writes a git-ignored .env
# with generated throwaway values. NEVER commit real values.
# Cloud dev/production: set values in Railway service variables (per service, per
# environment) and CI-only values in GitHub *environment* secrets. Never paste
# secrets into chat, issues, logs or screenshots. This repo is public.
#
# Classification tags:
#   [public]  safe to expose to the browser bundle (no secrets, ever)
#   [server]  server-only, not secret (still never sent to the browser)
#   [secret]  server-only credential; managed secret store only
# "req:" lists the environments where the value is mandatory.
# Full registry with owners and validation: docs/config-inventory.md
# Names are provisional until ADR-001/ADR-002 pick runtime and auth; the
# inventory is updated with any rename.

# --- Runtime -----------------------------------------------------------------
# [server] req: all. One of: local | test | dev | production
# (dev = cloud dev environment deployed from the dev branch, not local work)
APP_ENV=local
# [server] req: none (default info). debug | info | warning | error
LOG_LEVEL=info

# --- URLs and origins --------------------------------------------------------
# [public] req: all. Origin serving the web app (PWA).
PUBLIC_APP_URL=http://localhost:3000
# [public] req: all. Base URL of the versioned API (without /v1).
PUBLIC_API_URL=http://localhost:4000
# [server] req: dev, production. Comma-separated exact origins allowed by CORS.
API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# [server] req: none. true on hosted builds: the API also serves the built PWA (same origin).
SERVE_WEB=false

# --- Database ----------------------------------------------------------------
# [secret] req: all (local: PostgreSQL 16). postgresql://user:pass@host:port/db
DATABASE_URL=

# --- Authentication and email ------------------------------------------------
# [secret] req: all. Random >=32 bytes, distinct per environment. Signs sessions/CSRF tokens.
SESSION_SECRET=
# [server] req: dev, production. resend | brevo (send-only HTTPS APIs; no SMTP). Local leaves it empty.
EMAIL_PROVIDER=
# [server] req: dev, production. Sender, e.g. "The Better Plate <login@yourdomain>".
AUTH_EMAIL_FROM=
# [secret] req: dev, production. Transactional email provider key (provider chosen in ADR-002).
# Local logs emails to the console instead and leaves this empty.
EMAIL_PROVIDER_API_KEY=
# [server] req: none. Google OAuth "Web application" client id. Set both Google values or neither;
# when both are empty the "Continue with Google" button is hidden.
# Redirect URI to register at Google: <PUBLIC_API_URL>/v1/auth/callback/google
GOOGLE_CLIENT_ID=
# [secret] req: none. Google OAuth client secret. Never in the browser or chat.
GOOGLE_CLIENT_SECRET=

# --- Official food data ------------------------------------------------------
# [server] req: none. USDA FoodData Central API base URL.
USDA_FDC_API_BASE_URL=https://api.nal.usda.gov/fdc/v1
# [secret] req: dev, production (online search). Free api.data.gov key.
# Starter-catalog import uses the public bulk download and needs no key.
# Local development may leave this empty (falls back to DEMO_KEY limits: 30/hour).
# USDA_API_KEY is accepted as an alias (the GitHub Actions secret uses that name).
USDA_FDC_API_KEY=

# --- Feature flags (server-enforced defaults) --------------------------------
# [server] req: none. Chef commerce kill switch. MUST stay false in production
# until owner approval and release gates (docs/release-flags.md).
FEATURE_CHEF_ENABLED=false
# [server] req: none. Optional BYOK AI companion; off until its milestone ships.
FEATURE_AI_COMPANION_ENABLED=false

# --- Optional BYOK AI (later milestone) ---------------------------------------
# [secret] req: only when FEATURE_AI_COMPANION_ENABLED=true. Key-encryption key for
# per-user provider keys stored encrypted in the database.
# NO OPENAI/ANTHROPIC KEYS HERE: user keys live encrypted per user, never in env
# vars, browser storage, logs or bundles.
BYOK_ENCRYPTION_KEY=

# --- Optional observability ---------------------------------------------------
# [secret] req: none. Error-monitoring DSN, if a provider is approved (preflight O1).
ERROR_MONITORING_DSN=
