# THE BETTER PLATE — NON-SECRET CONFIGURATION TEMPLATE
# Copy locally to .env.local ONLY when appropriate. Never commit real credentials.
# Exact configuration may be revised after the agent selects a hosting architecture.
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
# Server-only secret (set locally or in hosting secret manager; never in frontend):
DATABASE_URL=
# Authentication settings: configure after authentication architecture selection.
AUTH_SECRET=
# Optional official food-data API key, if official provider requires one:
USDA_FDC_API_KEY=
# Object-storage credentials, if required by chosen provider:
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Optional monitoring credentials (server-side only):
ERROR_MONITORING_DSN=
# NO OPENAI/ANTHROPIC USER KEYS in environment variables: BYOK keys belong to
# per-user encrypted storage and must never be shipped to frontend bundles.
